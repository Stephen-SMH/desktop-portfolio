---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../../styles/global.css';
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import AppIcon from '../../components/AppIcon.astro';
import ComicStudioStory from '../../components/story/ComicStudioStory.astro';
import GitDeskStory from '../../components/story/GitDeskStory.astro';
import LanternStory from '../../components/story/LanternStory.astro';
import YayMalStory from '../../components/story/YayMalStory.astro';
import { profile, projects } from '../../data/content';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const app = projects.find((p) => p.slug === slug)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Real screenshots: drop files into public/shots/<slug>/ and they replace the concept screens.
const dir = join(process.cwd(), 'public', 'shots', app.slug);
const shots = existsSync(dir) ? readdirSync(dir).filter((f) => /\.(png|jpe?g|webp)$/i.test(f)).sort() : [];
const concept = ['Library', 'Script editor', 'Panel queue'];
// each app tells its story in its own visual style; apps without one fall back to plain paragraphs
const stories: Record<string, any> = { gitdesk: GitDeskStory, lantern: LanternStory, yaymal: YayMalStory, 'comic-studio': ComicStudioStory };
const Story = stories[app.slug];
const channels = [
  ['overview', 'overview'],
  ['story', 'story'],
  ['screenshots', 'screenshots'],
  ['features', 'features'],
  ['changelog', 'changelog'],
  ['roadmap', 'roadmap'],
  ['requirements', 'requirements'],
  ['download', 'download'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{app.name} — {profile.name}</title>
    <meta name="description" content={app.summary} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#feed">Skip to content</a>
    <div class="window">
      <div class="titlebar" role="presentation">
        <span class="dots"><a class="c" href={`${base}/`} data-g="×" aria-label="Close, back to the desktop"></a><button class="n" data-g="−" aria-label="Minimize to the desktop"></button><button class="x" data-g="+" aria-label="Toggle full width"></button></span>
        <span class="title mono">{app.name} — App page</span>
        <a class="back mono" href={`${base}/`}>← All apps</a>
      </div>

      <div class="dc">
        <nav class="rail" aria-label="Apps"><div class="stick">
          <a href={`${base}/`} data-tip="Home" aria-label="Home">⌂</a>
          <i aria-hidden="true"></i>
          {projects.map((p) => <a class={p.slug === app.slug ? 'on' : ''} style={`--tint:${p.tint}`} href={`${base}/apps/${p.slug}/`} data-tip={p.name} aria-label={p.name}><AppIcon d={p.icon} /></a>)}
        </div></nav>

        <aside class="chan" aria-label="Channels"><div class="stick">
          <h2><span class="glyph" style={`background:${app.tint}`} aria-hidden="true"><AppIcon d={app.icon} /></span>{app.name}</h2>
          <div class="cat">Info</div>
          {channels.slice(0, 4).map(([id, label]) => <a href={`#${id}`} data-ch={id}><b>#</b>{label}</a>)}
          <div class="cat">Releases</div>
          {channels.slice(4, 6).map(([id, label]) => <a href={`#${id}`} data-ch={id}><b>#</b>{label}</a>)}
          <div class="cat">Get it</div>
          {channels.slice(6).map(([id, label]) => <a href={`#${id}`} data-ch={id}><b>#</b>{label}</a>)}
        </div></aside>

        <main id="feed" class="feed">
          <div class="hdr mono"><b>#</b><span data-cur>overview</span><span class="sp"></span><span class={`status s-${app.status.replace(' ', '-').toLowerCase()}`}>{app.status}</span></div>

          <section id="overview">
            <div class="banner">
              <p class="eyebrow mono">{profile.role}</p>
              <h1>{app.name}</h1>
              <p>{app.summary}</p>
              {app.pipeline && <ol class="pipe mono" style="margin-top:16px">{app.pipeline.map((s) => <li>{s}</li>)}</ol>}
              <div class="cta">
                <span class="price"><small>Price</small>Free</span>
                <span class="btn off" aria-disabled="true">Download · coming with {app.roadmap.at(-1)?.id}</span>
                {app.repo && <a class="btn ghost" href={app.repo} rel="noopener">Source on GitHub</a>}
              </div>
            </div>
          </section>

          <section id="story">
            <h2 class="label mono"># story</h2>
            {Story ? <Story app={app} /> : <div class="story">{app.story.map((p) => <p>{p}</p>)}</div>}
          </section>

          <section id="screenshots">
            <h2 class="label mono"># screenshots</h2>
            {shots.length ? (
              <div class="gal">{shots.map((f, i) => <figure><img src={`${base}/shots/${app.slug}/${f}`} alt={`${app.name} screenshot ${i + 1}`} loading="lazy" /></figure>)}</div>
            ) : (<>
              <div class="gal">
                {concept.map((c, i) => (
                  <figure aria-label={`${c} concept screen`}>
                    <div class="scr" aria-hidden="true">
                      <div class="sb">{[0, 1, 2, 3, 4].map((k) => <i class={k === i + 1 ? 'on' : ''}></i>)}</div>
                      <div class="mn">{i === 1 ? <div class="ln"><i class="k"></i><i></i><i></i><i style="width:70%"></i><i></i><i style="width:55%"></i></div> : <div class="pn">{Array.from({ length: i === 0 ? 6 : 3 }).map(() => <i></i>)}</div>}</div>
                    </div>
                    <figcaption>{c}</figcaption>
                  </figure>
                ))}
              </div>
              <p class="note">Concept screens from the design docs. Real screenshots appear here once they are added to <code>public/shots/{app.slug}/</code>.</p>
            </>)}
          </section>

          <section id="features">
            <h2 class="label mono"># features</h2>
            <ul class="feats">{app.features.map((f) => <li>{f}</li>)}</ul>
            <ul class="chips" style="margin-top:20px" aria-label="Tech">{app.stack.map((x) => <li class="mono">{x}</li>)}</ul>
          </section>

          <section id="changelog">
            <h2 class="label mono"># changelog</h2>
            <ol class="log">
              {app.releases.map((r) => (
                <li>
                  <div class="h"><b>v{r.version}</b><time>{r.date}</time></div>
                  <h3>{r.title}</h3>
                  <ul>{r.notes.map((n) => <li>{n}</li>)}</ul>
                </li>
              ))}
            </ol>
          </section>

          <section id="roadmap">
            <h2 class="label mono"># roadmap</h2>
            <div class="road">
              {app.roadmap.map((m) => (
                <div><b>{m.id}</b><div><h3>{m.title}</h3><ul>{m.items.map((i) => <li>{i}</li>)}</ul></div></div>
              ))}
            </div>
          </section>

          <section id="requirements">
            <h2 class="label mono"># requirements</h2>
            <div class="req">
              <div><h3>Operating system</h3><ul>{app.requirements.os.map((r) => <li>{r}</li>)}</ul></div>
              <div><h3>Hardware</h3><ul>{app.requirements.hardware.map((r) => <li>{r}</li>)}</ul></div>
              <div><h3>Also needed</h3><ul>{app.requirements.software.map((r) => <li>{r}</li>)}</ul></div>
            </div>
          </section>

          <section id="download">
            <h2 class="label mono"># download</h2>
            <p style="color:var(--dim);max-width:60ch">{app.name} is still {app.status === 'Planning' ? 'in planning' : 'in progress'}. Signed builds for {app.platforms.join(', ')} arrive with milestone {app.roadmap.at(-1)?.id}. {app.repo && <>Follow the repository for releases{app.status === 'In progress' ? ', or build it from source today' : ''}.</>}</p>
            <div class="cta" style="margin-top:16px">
              {app.platforms.map((p) => <span class="btn ghost off">{p} · soon</span>)}
              {app.repo && <a class="btn" href={app.repo} rel="noopener">Follow on GitHub →</a>}
            </div>
          </section>
        </main>

        <aside class="info" aria-label="App details">
          <h2>About</h2>
          <dl>
            <div><dt>Status</dt><dd>{app.status}</dd></div>
            <div><dt>Version</dt><dd>{app.version}</dd></div>
            <div><dt>Started</dt><dd>{app.released}</dd></div>
            <div><dt>Updated</dt><dd>{app.updated}</dd></div>
            <div><dt>License</dt><dd>{app.license}</dd></div>
            <div><dt>Developer</dt><dd><a href={profile.github} rel="noopener" style="color:var(--accent-ink)">{profile.nick}</a></dd></div>
          </dl>
          <ul class="chips os" aria-label="Platforms">{app.platforms.map((x) => <li class="mono">{x}</li>)}</ul>
        </aside>
      </div>

      <footer class="statusbar mono">
        <span><i class="dot" aria-hidden="true"></i> Local-first</span>
        <span>Tauri · Rust · TypeScript</span>
        <span class="hide-sm">{profile.location}</span>
      </footer>
    </div>

    <script>
      // traffic lights: close and minimize go back to the desktop, the green one toggles full width
      const win = document.querySelector<HTMLElement>('.window')!;
      document.querySelector('.dots .n')!.addEventListener('click', () => { win.classList.add('min'); setTimeout(() => (location.href = document.querySelector<HTMLAnchorElement>('.dots .c')!.href), 380); });
      document.querySelector('.dots .x')!.addEventListener('click', () => document.documentElement.classList.toggle('max'));
      addEventListener('pageshow', () => win.classList.remove('min'));
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-ch]')];
      const cur = document.querySelector<HTMLElement>('[data-cur]')!;
      const secs = links.map((l) => document.getElementById(l.dataset.ch!)!).filter(Boolean);
      const mark = (id: string) => { links.forEach((l) => l.toggleAttribute('aria-current', l.dataset.ch === id)); cur.textContent = id; };
      // the section whose top has passed 35% of the viewport; at the very bottom, the last one
      const spy = () => {
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) return mark(secs.at(-1)!.id);
        let id = secs[0].id;
        for (const s of secs) if (s.getBoundingClientRect().top <= innerHeight * 0.35) id = s.id;
        mark(id);
      };
      let pinned = false; let t = 0;
      addEventListener('scroll', () => { if (!pinned) spy(); clearTimeout(t); t = setTimeout(() => { pinned = false; }, 150); }, { passive: true });
      // a clicked channel stays selected even if the page cannot scroll it all the way up
      links.forEach((l) => l.addEventListener('click', () => { pinned = true; mark(l.dataset.ch!); clearTimeout(t); t = setTimeout(() => { pinned = false; }, 1000); }));
      spy();
    </script>
  </body>
</html>
