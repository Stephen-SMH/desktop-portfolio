---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { profile, projects, skills } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} - Desktop Software</title>
    <meta name="description" content={profile.tagline} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <header class="bar wrap">
      <a class="mono" href={profile.hub}>← stephen-smh.github.io</a>
      <nav class="mono"><a href="#projects">Projects</a><a href="#stack">Stack</a><a href="#contact">Contact</a></nav>
    </header>

    <main class="wrap">
      <section class="hero">
        <p class="mono eyebrow">{profile.role} · {profile.location}</p>
        <h1>{profile.name}<span> / {profile.nick}</span></h1>
        <p class="lede">{profile.tagline}</p>
        <p class="sub">{profile.statement}</p>
      </section>

      <section id="projects">
        <h2 class="mono label">Projects</h2>
        <div class="grid">
          {projects.map((p) => (
            <article class="card">
              <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="body">
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
                <ul class="chips plat">{p.platforms.map((x) => <li class="mono">{x}</li>)}</ul>
                <ul class="chips">{p.stack.map((x) => <li class="mono">{x}</li>)}</ul>
                <div class="links mono">
                  {p.repo && <a href={p.repo} rel="noopener">Source →</a>}
                  {p.download && <a href={p.download} rel="noopener">Download →</a>}
                  {p.placeholder && <span class="ph">PLACEHOLDER</span>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="stack">
        <h2 class="mono label">Stack</h2>
        <div class="stack">
          {skills.map((s) => (
            <div>
              <h3 class="mono">{s.group}</h3>
              <ul class="chips">{s.items.map((i) => <li class="mono">{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <section id="contact">
        <h2 class="mono label">Contact</h2>
        <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p class="mono links"><a href={profile.github} rel="noopener">GitHub</a></p>
      </section>
    </main>
  </body>
</html>
