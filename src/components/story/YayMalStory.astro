---
// YayMal: paper style. A sheet of paper with a ribbon on top holds the intro, the .docx round trip is
// a light architecture diagram, and what is next is a to-do list.
import type { App } from '../../data/content';
interface Props { app: App }
const { app } = Astro.props;
const [p0, p1, p2] = app.story;
const tabs = ['File', 'Home', 'Insert', 'Layout', 'References', 'Review', 'View'];
const opens = ['Word', 'Google Docs', 'Pages', 'LibreOffice'];
const next = [
  { t: 'Comments and track changes', done: false },
  { t: 'Footnotes and section breaks', done: false },
  { t: 'Tables that split across pages', done: false },
  { t: 'A spreadsheet and a slides app on the same shell', done: false },
  { t: 'Ribbon, real pages and .docx round trip', done: true },
];
---
<div class="ym">
  <div class="sheet">
    <div class="ribbon" aria-hidden="true">
      <div class="tabs">{tabs.map((t, i) => <span class={i === 1 ? 'on' : ''}>{t}</span>)}</div>
      <div class="tools"><b>B</b><i>I</i><u>U</u><span class="sep"></span><span class="sty">Normal</span><span class="sty h">Heading 1</span><span class="sty">Title</span></div>
    </div>
    <div class="page">
      <div class="ruler" aria-hidden="true"></div>
      <p class="drop">{p0}</p>
      <div class="pg mono" aria-hidden="true">Page 1 of 1 · {p0.split(/\s+/).length} words</div>
    </div>
  </div>

  <p class="txt">{p1}</p>

  <figure class="arch" aria-label="How a document travels: the editor, the bundled .docx service, the file, and other word processors">
    <div class="dmg">
      <span class="lbl mono">inside YayMal.dmg</span>
      <div class="box ed"><b>Editor</b><small>React · TipTap / ProseMirror</small></div>
      <div class="link mono"><span>document JSON</span><i></i></div>
      <div class="box sv"><b>.docx service</b><small>FastAPI · python-docx, frozen in</small></div>
    </div>
    <div class="link mono v"><span>save / open</span><i></i></div>
    <div class="file"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12l1.2 5 1.8-4 1.8 4 1.2-5" /></svg><b>report.docx</b></div>
    <div class="link mono v"><span>opens in</span><i></i></div>
    <ul class="apps">{opens.map((o) => <li>{o}</li>)}</ul>
  </figure>

  <div class="todo">
    <h4>Next on the list</h4>
    <ul>{next.map((n) => <li class={n.done ? 'done' : ''}><i aria-hidden="true">{n.done ? '✓' : ''}</i>{n.t}</li>)}</ul>
    <p>{p2}</p>
  </div>
</div>

<style>
  .ym { display: grid; gap: 26px; }
  .sheet { border-radius: 14px; overflow: hidden; background: #e9edf5; box-shadow: 0 30px 70px -35px rgba(37,99,235,.55); color: #1e293b; }
  .ribbon { background: #f8fafc; border-bottom: 1px solid #d5dbe6; }
  .tabs { display: flex; gap: 2px; padding: 8px 10px 0; font-size: 12px; overflow: hidden; } .tabs span { padding: 5px 10px; border-radius: 6px 6px 0 0; color: #475569; white-space: nowrap; } .tabs .on { background: #fff; color: #1d4ed8; font-weight: 600; box-shadow: inset 0 -2px 0 #2563eb; }
  .tools { display: flex; align-items: center; gap: 6px; padding: 8px 12px; background: #fff; font-size: 13px; overflow: hidden; } .tools b, .tools i, .tools u { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 5px; color: #334155; } .tools b { background: #e0e7ff; }
  .sep { width: 1px; height: 18px; background: #e2e8f0; margin: 0 4px; } .sty { padding: 4px 10px; border: 1px solid #e2e8f0; border-radius: 5px; font-size: 12px; white-space: nowrap; color: #334155; } .sty.h { color: #1d4ed8; font-weight: 600; }
  .page { position: relative; margin: 18px auto 22px; width: min(88%, 520px); padding: 30px 34px 40px; background: #fff; box-shadow: 0 1px 3px rgba(15,23,42,.12), 0 12px 30px -12px rgba(15,23,42,.25); }
  .ruler { position: absolute; left: 34px; right: 34px; top: 12px; height: 6px; background: repeating-linear-gradient(90deg, #cbd5e1 0 1px, transparent 1px 12px); opacity: .7; }
  .drop { font: 16px/1.75 Georgia, 'Times New Roman', serif; color: #1e293b; } .drop::first-letter { float: left; font-size: 3.3em; line-height: .9; padding: 4px 8px 0 0; color: #2563eb; }
  .pg { position: absolute; right: 14px; bottom: 10px; font-size: 10px; color: #94a3b8; }
  .txt { color: var(--dim); line-height: 1.7; }

  .arch { margin: 0; display: grid; justify-items: center; gap: 4px; padding: 22px 16px; border-radius: 16px; background: #f1f5f9; color: #0f172a; }
  .dmg { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px; padding: 22px 14px 14px; border: 1.5px dashed #93c5fd; border-radius: 14px; width: 100%; }
  .dmg .lbl { position: absolute; top: -9px; left: 14px; padding: 0 8px; background: #f1f5f9; font-size: 11px; color: #2563eb; }
  .box { display: grid; padding: 10px 14px; border-radius: 10px; background: #fff; border: 1px solid #cbd5e1; box-shadow: 0 4px 12px -6px rgba(15,23,42,.2); min-width: 170px; } .box b { font-size: 14px; } .box small { font-size: 11.5px; color: #64748b; }
  .ed { border-top: 3px solid #2563eb; } .sv { border-top: 3px solid #7c3aed; }
  .link { display: grid; justify-items: center; font-size: 10.5px; color: #64748b; padding: 0 4px; } .link i { width: 44px; height: 2px; background: #94a3b8; position: relative; } .link i::after { content: ''; position: absolute; right: -1px; top: -3px; border: 4px solid transparent; border-left-color: #94a3b8; border-right: 0; }
  .link.v i { width: 2px; height: 18px; order: -1; } .link.v i::after { right: -3px; top: auto; bottom: -2px; border: 4px solid transparent; border-top-color: #94a3b8; border-bottom: 0; }
  .file { display: flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 10px; background: #2563eb; color: #fff; font: 600 13px var(--mono); } .file svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linejoin: round; stroke-linecap: round; }
  .apps { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; } .apps li { padding: 5px 12px; border-radius: 999px; background: #fff; border: 1px solid #cbd5e1; font-size: 12.5px; color: #334155; }

  .todo { padding: 18px 20px; border-radius: 14px; border: 1px solid var(--border); background: rgba(96,165,250,.05); }
  .todo h4 { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: #93c5fd; margin-bottom: 10px; }
  .todo ul { display: grid; gap: 8px; margin-bottom: 14px; } .todo li { display: flex; align-items: center; gap: 10px; font-size: 14.5px; color: var(--fg); }
  .todo li i { width: 16px; height: 16px; flex: none; display: grid; place-items: center; border-radius: 4px; border: 1.5px solid #60a5fa; font: normal 700 11px var(--sans); color: #fff; }
  .todo li.done { color: var(--faint); text-decoration: line-through; } .todo li.done i { background: #2563eb; border-color: #2563eb; }
  .todo p { color: var(--dim); line-height: 1.7; font-size: 15px; }
</style>
