---
// Lantern: game style. A lit dungeon map with the intro over it, three frames of the light shrinking,
// and the turn loop as a cycle.
import type { App } from '../../data/content';
interface Props { app: App }
const { app } = Astro.props;
const [p0, p1, p2] = app.story;

const map = [
  '#########################',
  '#.......#.......#.......#',
  '#.......#...!...#.......#',
  '#.......+.......+...w...#',
  '#...r...#.......#.......#',
  '####+####.......####+####',
  '#.......#...@...#.......#',
  '#.......#.......#.......#',
  '#.......+.......+.......#',
  '#.......#.......#...$...#',
  '#...!...#.......#.......#',
  '#.......#.......#.......#',
  '#########################',
];
const T = 16; const px = 12; const py = 6; const R = 6.5;
const tiles = map.flatMap((row, y) => [...row].map((ch, x) => {
  const d = Math.hypot(x - px, y - py);
  const lit = Math.max(0, 1 - d / R);
  return { x, y, ch, d, lit };
}));
const glyph: Record<string, { c: string; s: string }> = { '@': { c: '@', s: '#fde68a' }, r: { c: 'r', s: '#fca5a5' }, w: { c: 'w', s: '#c4b5fd' }, '!': { c: '!', s: '#f9a8d4' }, '$': { c: '$', s: '#fcd34d' }, '+': { c: '+', s: '#d6a36b' } };

// three frames of the same room as oil runs down
const frames = [
  { r: 4.6, oil: 100, label: 'Full tank', sub: 'light reaches 8 tiles' },
  { r: 2.8, oil: 45, label: 'Running low', sub: 'the circle closes in' },
  { r: 1.2, oil: 6, label: 'Last drops', sub: 'one tile, and the dark bites' },
];
const loop = ['You move or attack', 'The lantern burns oil', 'Monsters take their turn', 'The light shrinks or holds'];
---
<div class="lt">
  <figure class="hero" aria-label="A lit dungeon map: the player stands in a circle of lantern light, a wraith waits at its edge">
    <svg viewBox={`0 0 ${25 * T} ${13 * T}`} aria-hidden="true">
      <defs>
        <radialGradient id="glow" cx={(px + 0.5) * T} cy={(py + 0.5) * T} r={R * T} gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#fbbf24" stop-opacity=".35" /><stop offset=".6" stop-color="#f59e0b" stop-opacity=".12" /><stop offset="1" stop-color="#f59e0b" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="100%" height="100%" fill="#07060a" />
      {tiles.map((t) => t.lit > 0 && (
        t.ch === '#'
          ? <rect x={t.x * T} y={t.y * T} width={T} height={T} fill="#3b2f2a" opacity={0.25 + t.lit * 0.75} />
          : <rect x={t.x * T + 7} y={t.y * T + 7} width="2" height="2" fill="#a78b6d" opacity={t.lit} />
      ))}
      <rect width="100%" height="100%" fill="url(#glow)" />
      {tiles.filter((t) => glyph[t.ch] && (t.lit > 0 || t.ch === 'w')).map((t) => (
        <text x={t.x * T + T / 2} y={t.y * T + 12.5} fill={glyph[t.ch].s} opacity={t.ch === 'w' ? 0.55 : Math.max(0.35, t.lit + 0.3)} class={t.ch === '@' ? 'me' : ''}>{glyph[t.ch].c}</text>
      ))}
    </svg>
    <figcaption><p>{p0}</p></figcaption>
  </figure>

  <div class="frames" role="list">
    {frames.map((f) => (
      <div class="fr" role="listitem">
        <svg viewBox="0 0 90 90" aria-hidden="true">
          <rect width="90" height="90" fill="#07060a" />
          {Array.from({ length: 81 }, (_, i) => { const x = i % 9; const y = Math.floor(i / 9); const d = Math.hypot(x - 4, y - 4); const lit = Math.max(0, 1 - d / f.r); return lit > 0 && <rect x={x * 10 + 1} y={y * 10 + 1} width="8" height="8" rx="1.5" fill="#f59e0b" opacity={lit * 0.55} />; })}
          <text x="45" y="49.5" class="me2">@</text>
        </svg>
        <div class="oil"><i style={`width:${f.oil}%`}></i></div>
        <b>{f.label}</b><span>{f.sub}</span>
      </div>
    ))}
  </div>

  <div class="two">
    <p>{p1}</p>
    <figure class="loop" aria-label="The turn loop">
      <svg viewBox="0 0 220 220" aria-hidden="true">
        <circle cx="110" cy="110" r="78" class="ring" />
        {loop.map((_, i) => { const a = -Math.PI / 2 + (i * Math.PI) / 2; return <circle cx={110 + 78 * Math.cos(a)} cy={110 + 78 * Math.sin(a)} r="7" class="node" />; })}
        <text x="110" y="106" class="ctr">one</text><text x="110" y="122" class="ctr">turn</text>
      </svg>
      <ol class="mono">{loop.map((l, i) => <li><b>{i + 1}</b>{l}</li>)}</ol>
    </figure>
  </div>

  <aside class="bot mono">
    <div class="hd"><span>tune.rs</span><span class="ok">200 seeds</span></div>
    <p class="body">{p2}</p>
    <div class="seeds" aria-hidden="true">{Array.from({ length: 50 }, (_, i) => <i style={`opacity:${0.35 + ((i * 37) % 13) / 20}`}></i>)}</div>
  </aside>
</div>

<style>
  .lt { display: grid; gap: 26px; }
  .hero { position: relative; margin: 0; border-radius: 18px; overflow: hidden; border: 1px solid rgba(245,158,11,.25); box-shadow: 0 30px 80px -40px rgba(245,158,11,.5); background: #07060a; }
  .hero svg { display: block; width: 100%; height: auto; }
  .hero text { font: 700 12px var(--mono); text-anchor: middle; } .hero .me { font-size: 14px; filter: drop-shadow(0 0 6px #fbbf24); }
  .hero figcaption { padding: 16px 20px 20px; background: linear-gradient(180deg, rgba(7,6,10,0), #07060a 30%); margin-top: -40px; position: relative; }
  .hero figcaption p { font-size: 17.5px; line-height: 1.6; color: #fde9c4; }

  .frames { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .fr { display: grid; gap: 6px; padding: 10px; border-radius: 14px; background: #0c0a10; border: 1px solid rgba(245,158,11,.18); }
  .fr svg { width: 100%; height: auto; border-radius: 8px; } .me2 { fill: #fde68a; font: 700 10px var(--mono); text-anchor: middle; }
  .oil { height: 5px; border-radius: 3px; background: rgba(255,255,255,.08); overflow: hidden; } .oil i { display: block; height: 100%; background: linear-gradient(90deg, #f59e0b, #fde047); }
  .fr b { font-size: 13.5px; color: #fde9c4; } .fr span { font-size: 12px; color: var(--faint); line-height: 1.35; }

  .two { display: grid; gap: 18px; align-items: center; } .two > p { color: var(--dim); line-height: 1.7; }
  .loop { margin: 0; display: grid; grid-template-columns: 150px 1fr; gap: 14px; align-items: center; }
  .loop svg { width: 100%; height: auto; }
  .ring { fill: none; stroke: rgba(245,158,11,.5); stroke-width: 2; stroke-dasharray: 4 6; }
  .node { fill: #0c0a10; stroke: #fbbf24; stroke-width: 2; } .ctr { fill: #fde9c4; font: 600 13px var(--sans); text-anchor: middle; }
  .loop ol { display: grid; gap: 8px; font-size: 12.5px; color: #e7dcc8; } .loop li { display: flex; gap: 10px; align-items: baseline; } .loop li b { color: #f59e0b; }

  .bot { border-radius: 14px; border: 1px solid var(--border); background: #0b0e14; overflow: hidden; }
  .bot .hd { display: flex; justify-content: space-between; padding: 8px 14px; font-size: 11.5px; color: var(--faint); border-bottom: 1px solid var(--hair); } .bot .ok { color: #4ade80; }
  .bot .body { padding: 14px 14px 10px; font: 13px/1.65 var(--mono); color: #cbd5e1; }
  .seeds { display: grid; grid-template-columns: repeat(25, 1fr); gap: 3px; padding: 0 14px 14px; } .seeds i { aspect-ratio: 1; border-radius: 2px; background: #4ade80; }
  @media (min-width: 1180px) { .two { grid-template-columns: 1fr 1.1fr; } }
  @media (max-width: 560px) { .frames { grid-template-columns: 1fr; } .loop { grid-template-columns: 110px 1fr; } }
</style>
