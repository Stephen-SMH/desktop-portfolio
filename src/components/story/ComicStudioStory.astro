---
// Comic Studio: told as a comic page. Narration boxes carry the text; each panel is one step of the pipeline.
import type { App } from '../../data/content';
interface Props { app: App }
const { app } = Astro.props;
const [p0, p1, p2] = app.story;
const ms = app.roadmap.map((m) => ({ id: m.id, title: m.title }));
---
<div class="cs">
  <div class="page">
    <div class="cap wide">{p0}</div>

    <div class="pn p1 dots-pk">
      <span class="step">1</span>
      <div class="bubble">“A lighthouse keeper finds a robot washed up on the rocks…”</div>
      <div class="who"><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="14" r="7" /><path d="M7 38c1-9 6-13 13-13s12 4 13 13" /></svg></div>
      <span class="lab">You write the idea</span>
    </div>

    <div class="pn p2 dots-vi">
      <span class="step">2</span>
      <pre class="json mono" aria-hidden="true">{`{ "scene": 1,
  "panels": [
    { "shot": "wide",
      "says": "Who's there?" }
  ] }`}</pre>
      <span class="lab">A local LLM writes the script <em>LM Studio</em></span>
    </div>

    <div class="pn p3 dots-bl">
      <span class="step">3</span>
      <div class="queue" aria-hidden="true">
        <div><span>panel 1</span><i style="--w:100%"></i></div>
        <div><span>panel 2</span><i style="--w:64%"></i></div>
        <div><span>panel 3</span><i style="--w:0%"></i></div>
      </div>
      <span class="lab">Panels are drawn one by one <em>ComfyUI</em></span>
    </div>

    <div class="pn p4 dots-pk">
      <span class="step">4</span>
      <div class="mini" aria-hidden="true"><i></i><i></i><i></i><b>Who's there?</b></div>
      <span class="lab">Lay out the page and letter it</span>
    </div>

    <div class="pn p5 burst">
      <span class="step">5</span>
      <div class="out mono" aria-hidden="true"><span>PDF</span><span>CBZ</span><span>PNG</span></div>
      <span class="lab">Export</span>
    </div>

    <div class="cap wide alt"><b>No cloud.</b> Every step above runs on your own machine.</div>
  </div>

  <div class="txt">
    <p>{p1}</p>
    <p>{p2}</p>
  </div>

  <ol class="road" aria-label="Milestones">
    {ms.map((m, i) => <li class={i === 0 ? 'now' : ''}><b class="mono">{m.id}</b><span>{m.title}</span></li>)}
  </ol>
</div>

<style>
  .cs { display: grid; gap: 26px; }
  .page { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; padding: 10px; background: #f8f4ea; border-radius: 6px; box-shadow: 0 24px 60px -30px rgba(244,63,94,.6); transform: rotate(-.4deg); color: #111; }
  .cap { grid-column: span 6; padding: 10px 14px; background: #fde68a; border: 2.5px solid #111; font: 600 14.5px/1.55 var(--sans); color: #1c1917; }
  .cap.alt { background: #111; color: #fef3c7; font-weight: 500; } .cap.alt b { color: #fb7185; }
  .pn { position: relative; min-height: 150px; border: 2.5px solid #111; background: #fff; padding: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 8px; overflow: hidden; }
  .p1, .p2 { grid-column: span 3; } .p3 { grid-column: span 2; } .p4 { grid-column: span 2; } .p5 { grid-column: span 2; }
  .dots-pk { background-image: radial-gradient(rgba(244,63,94,.28) 1.2px, transparent 1.4px); background-size: 7px 7px; }
  .dots-vi { background-image: radial-gradient(rgba(124,58,237,.25) 1.2px, transparent 1.4px); background-size: 7px 7px; }
  .dots-bl { background-image: radial-gradient(rgba(37,99,235,.25) 1.2px, transparent 1.4px); background-size: 7px 7px; }
  .burst { background: repeating-conic-gradient(from 0deg at 50% 55%, #fde047 0 8deg, #fb923c 8deg 16deg); }
  .step { position: absolute; top: 6px; left: 6px; width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: #111; color: #fff; font: 700 12px var(--sans); }
  .lab { position: absolute; left: 0; right: 0; bottom: 0; padding: 4px 8px; background: #fff; border-top: 2.5px solid #111; font: 700 11.5px/1.3 var(--sans); text-transform: uppercase; letter-spacing: .02em; text-align: center; }
  .lab em { display: block; font-style: normal; font-weight: 500; text-transform: none; color: #6b21a8; }
  .bubble { position: relative; max-width: 88%; margin-bottom: 30px; padding: 8px 12px; background: #fff; border: 2px solid #111; border-radius: 18px; font: italic 600 13px/1.4 var(--sans); }
  .bubble::after { content: ''; position: absolute; left: 26px; bottom: -12px; border: 7px solid transparent; border-top: 12px solid #111; border-bottom: 0; }
  .who { position: absolute; left: 12px; bottom: 28px; width: 34px; } .who svg { fill: #fff; stroke: #111; stroke-width: 2.5; }
  .json { margin: 0 0 26px; padding: 8px 10px; background: #1e1b4b; color: #c4b5fd; border-radius: 6px; font-size: 10.5px; line-height: 1.45; border: 2px solid #111; }
  .queue { width: 100%; display: grid; gap: 7px; margin-bottom: 26px; font: 600 10.5px var(--mono); } .queue div { display: grid; grid-template-columns: 52px 1fr; align-items: center; gap: 6px; } .queue i { height: 9px; border: 1.5px solid #111; background: linear-gradient(90deg, #2563eb var(--w), #fff var(--w)); }
  .mini { position: relative; width: 82%; aspect-ratio: 4/3; margin-bottom: 26px; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 4px; } .mini i { border: 2px solid #111; background: #fce7f3; } .mini i:first-child { grid-row: span 2; background: #ede9fe; }
  .mini b { position: absolute; top: 6px; right: 4px; padding: 3px 7px; border: 1.5px solid #111; border-radius: 10px; background: #fff; font: 700 9.5px var(--sans); }
  .out { display: flex; gap: 6px; margin-bottom: 26px; } .out span { padding: 6px 9px; background: #fff; border: 2px solid #111; font-weight: 700; font-size: 12px; transform: rotate(-4deg); } .out span:nth-child(2) { transform: rotate(3deg) translateY(-6px); }
  .txt { display: grid; gap: 14px; } .txt p { color: var(--dim); line-height: 1.7; }
  .road { display: flex; gap: 0; overflow-x: auto; padding: 18px 2px 4px; scrollbar-width: thin; }
  .road li { position: relative; flex: 1 0 104px; display: grid; gap: 4px; padding-top: 14px; border-top: 2px solid rgba(255,255,255,.14); font-size: 12px; color: var(--faint); }
  .road li::before { content: ''; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: #1b1f2a; border: 2px solid rgba(255,255,255,.3); }
  .road li.now { color: var(--fg); border-top-color: #fb7185; } .road li.now::before { background: #fb7185; border-color: #fb7185; box-shadow: 0 0 12px #fb7185; }
  .road b { color: #fb7185; font-size: 12px; } .road span { padding-right: 10px; }
  @media (max-width: 560px) { .page { grid-template-columns: 1fr 1fr; transform: none; } .cap { grid-column: span 2; } .p1, .p2 { grid-column: span 2; } .p3, .p4 { grid-column: span 1; } .p5 { grid-column: span 2; } }
</style>
